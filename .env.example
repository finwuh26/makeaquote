# Discord Bot Token (required)
DISCORD_TOKEN=your_bot_token_here

# Discord Application/Client ID (required for deploying commands)
CLIENT_ID=your_client_id_here

# Optional: Guild ID for guild-only command deployment during development
# Leave blank for global deployment
GUILD_ID=

# Optional: Quotes API key (https://api-ninjas.com/ — free tier available)
# If omitted, the /randomquote command uses a built-in quote list.
QUOTES_API_KEY=
